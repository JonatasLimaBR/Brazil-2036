---
import Icon, { type IconName } from "./Icon.astro";
import { ARCHITECTURE_STATUS, type Status } from "../data/status";

const STATUS_LABEL: Record<Status, string> = {
  real: "Real",
  parcial: "Parcial",
  planejado: "Planejado",
};

const ARCH_ICON: Record<string, { icon: IconName; color: "green" | "yellow" | "blue" }> = {
  "cloud-storage": { icon: "database", color: "blue" },
  bigquery: { icon: "search", color: "green" },
  dataform: { icon: "gear", color: "yellow" },
  "pubsub-dataflow": { icon: "broadcast", color: "blue" },
  "alloydb-ai": { icon: "sparkle", color: "green" },
  "vertex-ai-gemini": { icon: "sparkle", color: "blue" },
  "cloud-run-api-gateway": { icon: "cloud", color: "green" },
  "knowledge-catalog": { icon: "book", color: "yellow" },
  "iam-seguranca": { icon: "shield", color: "blue" },
  observabilidade: { icon: "eye", color: "green" },
  finops: { icon: "coin", color: "yellow" },
  "mlops-llmops": { icon: "layers", color: "blue" },
};
---

<section id="arquitetura">
  <h2 class="section-title">Arquitetura GCP</h2>
  <div class="architecture-grid">
    {
      ARCHITECTURE_STATUS.map((entry) => {
        const { icon, color } = ARCH_ICON[entry.id] ?? { icon: "sparkle", color: "blue" };
        return (
          <article class="architecture-card" data-status-id={entry.id} data-evidence={entry.evidence}>
            <div class={`icon-badge icon-badge--${color}`}>
              <Icon name={icon} />
            </div>
            <h3>{entry.label}</h3>
            <span class={`status-badge status-badge--${entry.status}`}>{STATUS_LABEL[entry.status]}</span>
          </article>
        );
      })
    }
  </div>
  <p class="architecture-caption">Lakehouse · IA · Knowledge Graph · RAG · Agentes sobre GCP</p>
</section>
