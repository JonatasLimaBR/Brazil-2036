---
const links = [
  { href: "#visao-geral", label: "Visão Geral" },
  { href: "#modulos", label: "Módulos" },
  { href: "#arquitetura", label: "Arquitetura" },
  { href: "#roadmap", label: "Roadmap" },
  { href: "#portais", label: "Portais" },
  { href: "#contato", label: "Contato" },
];
---

<header class="nav">
  <a class="nav__brand" href="#visao-geral">
    <svg
      class="logo-mark"
      width="30"
      height="30"
      viewBox="0 0 32 32"
      fill="none"
      stroke-width="3"
      stroke-linecap="round"
    >
      <path d="M6 27 L14 5" stroke="#1b7a3d" />
      <path d="M12 27 L20 5" stroke="#f0c419" />
      <path d="M18 27 L26 5" stroke="#1c3f94" />
    </svg>
    BRASIL 2036
  </a>
  <ul class="nav__links">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <a class="nav__cta nav__cta--secondary" href="#roadmap">Ver Roadmap</a>
  <a class="nav__cta" href="#dados-reais">Explorar Plataforma</a>
</header>
