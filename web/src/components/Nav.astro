---
const tabs = [
  { id: "home", label: "Home" },
  { id: "dados", label: "Dados Reais" },
  { id: "modulos-portais", label: "Módulos & Portais" },
  { id: "arquitetura-roadmap", label: "Arquitetura & Roadmap" },
  { id: "sobre", label: "Sobre" },
];
---

<header class="nav">
  <a class="nav__brand" href="#home">
    <svg
      class="logo-mark"
      width="30"
      height="30"
      viewBox="0 0 32 32"
      fill="none"
      stroke-width="3"
      stroke-linecap="round"
    >
      <path d="M6 27 L14 5" stroke="#1b7a3d" />
      <path d="M12 27 L20 5" stroke="#f0c419" />
      <path d="M18 27 L26 5" stroke="#1c3f94" />
    </svg>
    BRASIL 2036
  </a>
  <ul class="nav__links" role="tablist" aria-label="Seções da landing page">
    {
      tabs.map((t, i) => (
        <li>
          <button
            type="button"
            role="tab"
            id={`tab-btn-${t.id}`}
            aria-controls={`tab-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-tab-target={t.id}
          >
            {t.label}
          </button>
        </li>
      ))
    }
  </ul>
  <a class="nav__cta nav__cta--secondary" href="#arquitetura-roadmap">Ver Roadmap</a>
  <a class="nav__cta" href="#dados">Explorar Plataforma</a>
</header>

<script>
  const TAB_IDS = ["home", "dados", "modulos-portais", "arquitetura-roadmap", "sobre"];

  function tabButtons(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab-target]"));
  }

  function activate(tabId: string): void {
    const id = TAB_IDS.includes(tabId) ? tabId : "home";
    for (const t of TAB_IDS) {
      const panel = document.getElementById(`tab-${t}`);
      const btn = document.getElementById(`tab-btn-${t}`);
      if (panel) panel.hidden = t !== id;
      if (btn) {
        const active = t === id;
        btn.setAttribute("aria-selected", String(active));
        btn.tabIndex = active ? 0 : -1;
      }
    }
  }

  function currentHashTab(): string {
    return window.location.hash.replace("#", "") || "home";
  }

  tabButtons().forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.tabTarget;
      if (!target) return;
      if (window.location.hash === `#${target}`) {
        activate(target);
      } else {
        window.location.hash = target;
      }
    });
  });

  // WAI-ARIA APG tabs pattern: seta esquerda/direita move o foco entre abas.
  document.querySelector('[role="tablist"]')?.addEventListener("keydown", (event) => {
    const e = event as KeyboardEvent;
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    const buttons = tabButtons();
    const idx = buttons.findIndex((b) => b === document.activeElement);
    if (idx === -1) return;
    e.preventDefault();
    const nextIdx =
      e.key === "ArrowRight" ? (idx + 1) % buttons.length : (idx - 1 + buttons.length) % buttons.length;
    buttons[nextIdx]?.focus();
  });

  window.addEventListener("hashchange", () => activate(currentHashTab()));
  activate(currentHashTab());
</script>
