---
import Icon, { type IconName } from "./Icon.astro";

const portals: { label: string; icon: IconName; color: "green" | "yellow" | "blue" }[] = [
  { label: "Portal Público", icon: "globe", color: "green" },
  { label: "Portal Executivo", icon: "briefcase", color: "yellow" },
  { label: "Portal Analítico", icon: "eye", color: "blue" },
  { label: "Portal INSS", icon: "id-card", color: "green" },
  { label: "Portal Estados e Municípios", icon: "pin", color: "yellow" },
  { label: "Policy Lab", icon: "flask", color: "blue" },
  { label: "Agent Center", icon: "cpu", color: "green" },
  { label: "Administração da Plataforma", icon: "gear", color: "yellow" },
];
---

<section id="portais">
  <h2 class="section-title">Portais e Experiência</h2>
  <p class="portals-subtitle">
    Experiências digitais para cada público, com acessos seguros e personalizados.
  </p>
  <div class="card-grid">
    {
      portals.map((portal) => (
        <article class="simple-card">
          <div class={`icon-badge icon-badge--${portal.color}`}>
            <Icon name={portal.icon} />
          </div>
          <h3>{portal.label}</h3>
        </article>
      ))
    }
  </div>
</section>

<style>
  .portals-subtitle {
    text-align: center;
    color: var(--muted);
    margin: -1rem 0 2rem;
  }
</style>
