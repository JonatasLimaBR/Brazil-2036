---
const cards: { id: string; label: string; value: string; source: string }[] = [
  {
    id: "pib-2026",
    label: "PIB — projeção 2026",
    value: "+2,3%",
    source: "SPE/MF — Boletim Macrofiscal de julho/2026",
  },
  {
    id: "ipca-2026",
    label: "IPCA — projeção 2026",
    value: "5,1%",
    source: "SPE/MF — Boletim Macrofiscal de julho/2026",
  },
  {
    id: "divida-bruta-pib-2026",
    label: "Dívida Bruta/PIB — 2026",
    value: "83,0%",
    source: "Prisma Fiscal — agosto/2026",
  },
  {
    id: "divida-bruta-pib-2027",
    label: "Dívida Bruta/PIB — 2027",
    value: "86,77%",
    source: "Prisma Fiscal — agosto/2026",
  },
  {
    id: "deficit-primario-2026",
    label: "Déficit primário Gov. Central 2026",
    value: "R$ 59,145 bi",
    source: "Mediana Prisma Fiscal — agosto/2026",
  },
  {
    id: "receita-liquida-2026",
    label: "Receita líquida 2026",
    value: "R$ 2,574 tri",
    source: "Mediana Prisma Fiscal — agosto/2026",
  },
  {
    id: "despesa-total-2026",
