---
const expectations: string[] = [
  "Criar uma referência nacional para leitura integrada da economia, das contas públicas e dos principais sistemas sociais.",
  "Reduzir o tempo entre a publicação de dados oficiais e sua transformação em informação acionável.",
  "Permitir que decisões e propostas sejam comparadas por cenários, custos, riscos e resultados esperados.",
  "Ampliar a capacidade de antecipação por meio de alertas, previsões e simulações.",
  "Estabelecer uma base técnica comum para analistas, gestores, pesquisadores e sociedade.",
  "Evoluir para um Digital Twin econômico, fiscal e social do Brasil, sustentado por dados públicos e governança.",
];
---

<section id="expectativas">
  <h2 class="section-title">Expectativas com a iniciativa</h2>
  <ul class="expectations-list">
    {expectations.map((e) => <li>{e}</li>)}
  </ul>
</section>
